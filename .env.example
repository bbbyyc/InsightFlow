# Copy this file to .env. Never commit .env or real credentials.
POSTGRES_DB=insightflow
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
MCP_PORT=8001
IMAGE_TAG=local

# Required only for generated answers, query rewriting, reranking and LLM Judge.
# Upload, parsing, embeddings and retrieval do not require this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=25
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=5
CELERY_CONCURRENCY=1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
